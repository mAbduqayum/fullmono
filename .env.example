# Copied to .env by `just setup`. Compose and just read .env; git ignores it.
# Real secrets go in .env (or the server's own .env), never in this file.

POSTGRES_USER=fullmono
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fullmono

# Where `just up` serves the site: http://localhost:8000
WEB_PORT=8000

# For the api when it runs on the host (`just dev`): Postgres is on localhost
# there, while inside compose it's the `db` service. Change both ports if
# another Postgres already has 5432.
DB_PORT=5432
DATABASE_URL=postgres://fullmono:change-me@localhost:5432/fullmono?sslmode=disable
