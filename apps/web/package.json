{
    "name": "@fullmono/web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "gen": "openapi-typescript ../api/openapi.yaml -o src/api.gen.ts"
    },
    "dependencies": {
        "openapi-fetch": "0.17.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.3",
        "openapi-typescript": "7.13.0",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "typescript": "~7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "packageManager": "bun@1.4.3"
}
