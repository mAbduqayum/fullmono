# The site's one front door: the web app's files, and the api behind them.
#
# SITE_ADDRESS is :80 locally (plain HTTP). In production it's the domain,
# say links.example.com, and Caddy then gets and renews its HTTPS certificate
# by itself and redirects HTTP to HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api/* /r/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv
		# A client-side route has no file: serve the app, and let it route.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# HTTPS only, for a year, even if a link says http://. Browsers ignore
		# it over plain HTTP, so it changes nothing on the local :80.
		Strict-Transport-Security "max-age=31536000"
		# Scripts, styles and requests from this origin only: an injected
		# <script> or one from another site doesn't run, nor does the page load
		# in another site's frame.
		Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Vite puts a content hash in these names, so they can be cached forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	log
}
