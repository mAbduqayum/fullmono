# The api's recipes: `just api <recipe>` from the root, or `just <recipe>` here.
# They run in apps/api.

# Download the Go modules
setup:
    go mod download

# Run the api on the host, against the database `just db` started
dev:
    go run ./cmd/api

# The unit tests, with the race detector; the integration tests skip
test:
    go test -race ./...

# Unit and integration tests, against the database `just db` started.
# -count=1: Go's test cache can't see the database, so never reuse a result.
test-integration:
    TEST_DATABASE_URL="$DATABASE_URL" go test -race -count=1 ./...

# Lint with the linters .golangci.yml turns on
lint:
    golangci-lint run

# Format the Go files
fmt:
    gofmt -w .

# Build the binary to bin/api
build:
    go build -o bin/api ./cmd/api
