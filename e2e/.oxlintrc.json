{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "node": true
    },
    "ignorePatterns": ["playwright-report", "test-results"],
    "rules": {
        "typescript/no-explicit-any": "error"
    }
}
